<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="Screens.uss" />
    <ui:Style src="Front.uss" />
    <ui:VisualElement class="page page--center">
        <Ashen.Presentation.UI.Kit.Shell name="SHELL" title-key="creation.title">
            <Ashen.Presentation.UI.Kit.Workspace name="WORKSPACE" class="creation-workspace">
                <ui:VisualElement name="CLASS_PANE" class="class-pane">
                    <ui:VisualElement class="class-toolbar">
                        <Ashen.Presentation.UI.LocButton name="CLASS_VIEW_LIST" class="class-view kit-chip" string-key="creation.view.list" />
                        <Ashen.Presentation.UI.LocButton name="CLASS_VIEW_GRID" class="class-view kit-chip" string-key="creation.view.grid" />
                    </ui:VisualElement>
                    <ui:ScrollView name="CLASS_SCROLL" class="class-scroll">
                        <ui:VisualElement name="CLASS_LIST" class="class-list" />
                    </ui:ScrollView>
                </ui:VisualElement>
                <ui:VisualElement name="REVIEW_PANE" class="review-pane is-hidden">
                    <ui:ScrollView name="REVIEW_SCROLL" class="review-scroll">
                        <ui:VisualElement name="REVIEW_BODY" />
                    </ui:ScrollView>
                </ui:VisualElement>
            </Ashen.Presentation.UI.Kit.Workspace>
        </Ashen.Presentation.UI.Kit.Shell>
    </ui:VisualElement>
</ui:UXML>
