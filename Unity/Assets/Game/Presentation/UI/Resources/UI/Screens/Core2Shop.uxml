<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="Screens.uss" />
    <ui:Style src="Map.uss" />
    <ui:Style src="Core2Shop.uss" />
    <ui:Style src="../Kit/CombatModal.uss" />
    <ui:VisualElement name="SHOP_PAGE" class="page c2shop-page">
        <ui:VisualElement name="CSHOP_SCENE" class="c2shop-scene" picking-mode="Ignore" />
        <ui:VisualElement name="CSHOP_PORTRAIT" class="c2shop-portrait" picking-mode="Ignore" />
        <ui:VisualElement name="RUN_HUD" class="board-hud map-hud">
            <ui:VisualElement name="HUD_HEART" class="hud-heart" picking-mode="Ignore" />
            <Ashen.Presentation.UI.Kit.Meter name="HUD_HP" class="hud-hp" kind="hp" picking-mode="Ignore" />
            <ui:VisualElement name="HUD_PIPS" class="hud-pips" picking-mode="Ignore" />
            <ui:VisualElement name="HUD_SIDE" class="hud-side" picking-mode="Ignore">
                <ui:VisualElement class="hud-buttons" picking-mode="Ignore">
                    <Ashen.Presentation.UI.LocButton name="TOOL_ARMAMENTS" class="hud-icon-button" string-key="core2.tools.armaments" />
                    <Ashen.Presentation.UI.LocButton name="HUD_MENU" class="hud-icon-button" string-key="combat.menu" />
                </ui:VisualElement>
                <Ashen.Presentation.UI.LocLabel name="HUD_CINDERS" class="hud-cinders kit-text-header kit-upper" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <Ashen.Presentation.UI.Kit.CombatModal name="CSHOP_FRAME" size="shop" class="c2shop-frame" />
    </ui:VisualElement>
    <ui:VisualElement name="CSHOP_SCRIM" class="overlay-scrim is-hidden">
        <Ashen.Presentation.UI.Kit.CombatModal name="CSHOP_MODAL" size="md" />
    </ui:VisualElement>
</ui:UXML>
