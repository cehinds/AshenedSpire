<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="Screens.uss" />
    <ui:Style src="Combat.uss" />
    <ui:Style src="Core2Combat.uss" />
    <ui:VisualElement name="COMBAT_BACKGROUND" class="combat-background" picking-mode="Ignore" />
    <ui:VisualElement name="COMBAT_PAGE" class="page combat-page">
        <ui:VisualElement name="RUN_HUD" class="combat-hud">
            <ui:VisualElement name="HUD_PORTRAIT" class="hud-portrait" />
            <ui:VisualElement class="hud-identity">
                <Ashen.Presentation.UI.LocLabel name="HUD_NAME" class="hud-name kit-text-value" />
                <Ashen.Presentation.UI.LocLabel name="HUD_TRAIL" class="hud-trail kit-text-header" />
            </ui:VisualElement>
            <ui:VisualElement name="HUD_METERS" class="hud-meters">
                <Ashen.Presentation.UI.Kit.Meter name="HUD_HP" class="hud-meter" kind="hp" glyph-key="resource.hp.name" />
                <Ashen.Presentation.UI.Kit.Meter name="HUD_MP" class="hud-meter" kind="mp" glyph-key="resource.mana.name" />
                <Ashen.Presentation.UI.Kit.Meter name="HUD_SP" class="hud-meter" kind="sp" glyph-key="resource.stamina.name" />
            </ui:VisualElement>
            <Ashen.Presentation.UI.LocButton name="HUD_MENU" class="hud-menu" string-key="combat.menu" />
        </ui:VisualElement>
        <ui:VisualElement name="BATTLEFIELD" class="battlefield">
            <ui:VisualElement name="ALLY_ROW" class="ally-row" />
            <ui:VisualElement name="ENEMY_ROW" class="enemy-row" />
            <Ashen.Presentation.UI.LocLabel name="PHASE_BANNER" class="phase-banner kit-text-header is-hidden" />
            <Ashen.Presentation.UI.LocLabel name="NOTICE" class="combat-notice kit-text-value is-hidden" />
            <Ashen.Presentation.UI.LocLabel name="TARGET_PROMPT" class="band-prompt kit-text-value is-hidden" />
            <ui:VisualElement name="COMBAT_LOG" class="combat-log">
                <Ashen.Presentation.UI.LocLabel name="LOG_TITLE" class="log-title kit-text-header" string-key="core2.log.title" />
                <ui:VisualElement name="LOG_LINES" class="log-lines" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="HAND_BAND" class="hand-band">
            <Ashen.Presentation.UI.Kit.HandFan name="HAND" class="combat-hand" />
        </ui:VisualElement>
        <ui:VisualElement name="COMBAT_FOOTER" class="combat-footer core2-footer">
            <ui:VisualElement name="FOOTER_TOOLS" class="footer-tools">
                <Ashen.Presentation.UI.LocButton name="TOOL_REACTIONS" class="tool-button" />
                <Ashen.Presentation.UI.LocButton name="TOOL_ARMAMENTS" class="tool-button" string-key="core2.tools.armaments" />
                <Ashen.Presentation.UI.LocButton name="TOOL_RECOVER" class="tool-button is-hidden" string-key="core2.tools.recover" />
            </ui:VisualElement>
            <Ashen.Presentation.UI.Kit.FooterGroup name="FOOTER_GROUP" class="combat-footer-group" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="PROMPT_PANEL" class="prompt-panel is-hidden">
        <Ashen.Presentation.UI.LocLabel name="PROMPT_TITLE" class="prompt-title kit-text-header" />
        <ui:ScrollView name="PROMPT_LIST" class="prompt-list" />
        <ui:VisualElement name="PROMPT_FOOTER" class="prompt-footer">
            <Ashen.Presentation.UI.LocButton name="PROMPT_BACK" class="kit-button--back prompt-button" string-key="core2.prompt.back" />
            <ui:VisualElement class="footer-gap" />
            <Ashen.Presentation.UI.LocButton name="PROMPT_CONFIRM" class="kit-button--primary prompt-button is-hidden" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="COMBAT_END" class="page page--center scrim combat-end is-hidden">
        <ui:VisualElement class="end-panel">
            <Ashen.Presentation.UI.LocLabel name="END_TITLE" class="end-title kit-text-header" />
            <Ashen.Presentation.UI.LocLabel name="END_BODY" class="end-body kit-text-value" />
            <Ashen.Presentation.UI.LocLabel name="END_PLANNED" class="end-planned kit-text-value" />
            <ui:VisualElement class="end-footer">
                <Ashen.Presentation.UI.LocButton name="END_CONTINUE" class="kit-button--primary kit-button--ready end-button" string-key="core2.end.continue" />
                <Ashen.Presentation.UI.LocButton name="END_SUMMARY" class="kit-button--primary kit-button--ready end-button is-hidden" string-key="combat.end.summary" />
                <ui:VisualElement class="footer-gap" />
                <Ashen.Presentation.UI.LocButton name="END_TO_TITLE" class="end-button" string-key="combat.end.toTitle" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
