/* Screen layouts (docs/design/04 W-02, W-03, W-23, W-24). Values come only from Tokens.uss variables. */

.page {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.page--center {
    align-items: center;
    justify-content: center;
}

.scrim {
    background-color: var(--color-scrim);
}

/* ---- W-24 boot ---- */

.boot-page {
    background-color: var(--color-scrim-soft);
}

.boot-bar {
    width: var(--size-boot-bar-width);
    margin-top: var(--space-xxl);
}

.layout-narrow .boot-bar {
    width: var(--size-slot-list-width);
}

.boot-status {
    margin-top: var(--space-lg);
    color: var(--color-parchment);
}

/* ---- W-24 content error ---- */

.error-body {
    white-space: normal;
    margin-bottom: var(--space-md);
}

.report-list {
    flex-grow: 1;
    background-color: var(--color-bg);
    border-color: var(--color-line);
    border-width: var(--border-hairline);
}

.report-row {
    padding: var(--space-xs) var(--space-sm);
    font-size: var(--font-caption);
    color: var(--color-danger);
    white-space: normal;
}

/* ---- W-02 title (VP-12, D-1000): the web's TitleMenu (src/ui/screens/title.js, styles/kit.css:596-614, player-polish.css:210-243, 373-379).
        The door painting fills the page, the wordmark glows gold over a column of plate entries, an ornate divider on each side of the menu,
        the tagline under it and the build stamp at the foot. The startup gate shows the same head in parchment over the unlit city. ---- */

.title-page {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--space-xl) var(--space-xl) var(--space-xl) var(--space-xl);
}

.title-art {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-bg);
    -unity-background-scale-mode: scale-and-crop;
}

.title-art--phone {
    display: none;
}

.layout-narrow .title-art--door {
    display: none;
}

.layout-narrow .title-art--phone {
    display: flex;
}

.title-art--gate {
    display: none;
    -unity-background-image-tint-color: var(--color-title-gate-dim);
}

.gate-active .title-art--gate {
    display: flex;
}

/* The startup entrance (web startupGate.js, kit.css:4834-4890): a press lights the city (the lit painting fades in), the city is held, then it fades away over the hall. */
.title-art--lit {
    display: none;
    opacity: 0;
    -unity-background-image-tint-color: var(--color-title-gate-dim);
    transition-property: opacity;
    transition-duration: var(--duration-title-light-up);
}

.gate-active .title-art--lit {
    display: flex;
}

.gate-lighting .title-art--lit {
    opacity: 1;
}

.gate-lighting .gate {
    opacity: 0;
    transition-property: opacity;
    transition-duration: var(--duration-title-lockup-away);
}

.gate-leaving .title-art--gate,
.gate-leaving .title-art--lit {
    display: flex;
    opacity: 1;
    transition-property: opacity;
    transition-duration: var(--duration-title-fade);
}

.gate-leaving.gate-leaving--out .title-art--gate,
.gate-leaving.gate-leaving--out .title-art--lit {
    opacity: 0;
}

.gate-active .title-art--door {
    display: none;
}

.title-head {
    align-items: center;
}

.subtitle {
    margin-top: var(--space-sm);
    font-size: var(--font-title-sub);
    letter-spacing: var(--size-title-sub-track);
    color: var(--color-muted);
}

.title-divider {
    width: var(--size-title-divider-w);
    margin-top: var(--space-md);
    margin-bottom: var(--space-md);
}

.gate-active .wordmark {
    color: var(--color-parchment);
}

.title-main {
    align-items: center;
    opacity: 1;
    transition-property: opacity;
    transition-duration: var(--duration-gate-fade);
}

.menu {
    width: var(--size-title-menu-w);
}

.menu-item {
    min-height: var(--size-title-entry-h);
    height: var(--size-title-entry-h);
    margin-bottom: var(--space-sm);
    padding-top: 0;
    padding-bottom: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    color: var(--color-parchment);
    font-size: var(--font-button);
}

.menu-item:hover,
.menu-item:focus {
    color: var(--color-gold);
}

.menu-item--ready,
.menu-item--ready:hover,
.menu-item--ready:focus {
    color: var(--color-ready-text);
}

.menu-icon {
    flex-shrink: 0;
    width: var(--size-title-icon);
    height: var(--size-title-icon);
    margin-right: var(--space-md);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--color-gold);
}

.menu-label {
    color: inherit;
    letter-spacing: var(--size-track-button);
    -unity-font-definition: url("../Fonts/Cinzel-Regular.ttf");
}

/* The save the title would continue: a taller plate with the journey icon, the class, the facts and the arrow. */
.menu-item--continue,
.menu-item--continue:disabled {
    height: var(--size-title-continue-h);
    min-height: var(--size-title-continue-h);
    justify-content: flex-start;
    padding-left: var(--space-lg);
    padding-right: var(--space-lg);
    background-image: url("../Frames/plate-hover.png");
}

.menu-item--continue .menu-icon {
    margin-right: var(--size-title-continue-gap);
}

.no-save .menu-item--continue {
    display: none;
}

.continue-texts {
    flex-grow: 1;
    flex-shrink: 1;
    align-items: flex-start;
}

.continue-head {
    font-size: var(--font-title-continue-head);
    color: var(--color-gold);
    -unity-font-style: bold;
    letter-spacing: var(--size-track-button);
}

.continue-name {
    margin-top: var(--space-xxs);
    font-size: var(--font-title-continue-name);
    color: var(--color-parchment);
    -unity-font-style: bold;
    letter-spacing: var(--size-track-label);
}

.continue-facts {
    margin-top: var(--space-xxs);
    font-size: var(--font-title-continue-facts);
    color: var(--color-muted);
    letter-spacing: var(--size-track-label);
}

.continue-arrow {
    flex-shrink: 0;
    width: var(--size-title-arrow);
    height: var(--size-title-arrow);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--color-gold);
}

.tagline {
    font-size: var(--font-title-tagline);
    letter-spacing: var(--size-title-tagline-track);
    color: var(--color-muted);
    -unity-text-align: middle-center;
}

.title-footer {
    position: absolute;
    left: var(--space-xl);
    right: var(--space-xl);
    bottom: var(--space-md);
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.build {
    letter-spacing: var(--size-track-label);
    color: var(--color-muted);
}

.ai-disclosure {
    position: absolute;
    right: 0;
    bottom: 0;
    background-color: var(--color-transparent);
    border-color: var(--color-transparent);
    font-size: var(--font-caption);
    color: var(--color-muted);
    padding-left: var(--space-md);
    padding-right: var(--space-md);
}

.gate {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    padding-top: var(--size-title-gate-prompt-top);
}

.gate-active .gate {
    display: flex;
}

.gate-active .title-main {
    position: absolute;
    opacity: 0;
    visibility: hidden;
}

.gate-prompt {
    font-size: var(--font-title-gate-prompt);
    letter-spacing: var(--size-title-tagline-track);
    color: var(--color-parchment);
    padding: var(--space-sm) var(--space-xl);
    opacity: var(--opacity-title-gate-prompt);
    transition-property: opacity;
    transition-duration: var(--duration-gate-pulse);
}

.gate-pulse .gate-prompt {
    opacity: var(--opacity-gate-dim);
}

.band-compact .title-page {
    padding-top: var(--space-md);
    padding-bottom: var(--space-sm);
}

.band-compact .subtitle,
.band-compact .tagline {
    display: none;
}

.band-compact .menu-item {
    margin-bottom: var(--space-xs);
}

.layout-narrow .title-page {
    padding: var(--space-xl) var(--space-md) var(--space-md) var(--space-md);
}

.layout-narrow .menu {
    width: var(--size-slot-list-width);
}

.layout-narrow .menu-item {
    height: var(--size-menu-row-narrow-h);
    min-height: var(--size-menu-row-narrow-h);
}

.layout-narrow .menu-item--continue {
    height: var(--size-title-continue-h);
    min-height: var(--size-title-continue-h);
}

/* ---- W-03 slots (VP-12, D-1002): the web's slot door is a narrow modal, not a full-screen shell ---- */

.shell.slots-shell {
    width: var(--size-slots-shell-w);
    height: auto;
    max-height: var(--size-shell-height);
}

.slots-shell .shell-body {
    flex-grow: 0;
}

.slots-shell .shell-footer-button {
    width: var(--size-half-gap-width);
}

.slots-divider {
    align-self: center;
    width: var(--size-title-divider-w);
    margin-bottom: var(--space-md);
}

.layout-narrow .shell.slots-shell {
    width: var(--size-full-width);
    height: var(--size-full-width);
    max-height: none;
}

.slot-list {
    flex-grow: 1;
}

.empty-state {
    margin-bottom: var(--space-md);
    font-size: var(--font-heading);
    color: var(--color-muted);
    -unity-text-align: middle-center;
}

.notice {
    margin-top: var(--space-sm);
    font-size: var(--font-caption);
    color: var(--color-danger);
}

/* ---- kit review sheet ---- */

.kit-scroll {
    flex-grow: 1;
}

.kit-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    margin-bottom: var(--space-lg);
}

.kit-cell {
    margin-right: var(--space-xl);
}

.kit-workspace {
    width: var(--size-kit-workspace-w);
    min-height: var(--size-kit-workspace-h);
    margin-right: var(--space-xl);
}

.kit-pane-text {
    white-space: normal;
}

.kit-tooltips {
    flex-direction: row;
    flex-wrap: wrap;
}

.kit-tooltips .tooltip {
    position: relative;
    margin-right: var(--space-sm);
    margin-bottom: var(--space-sm);
}

.kit-cards {
    flex-direction: row;
}

.kit-hand {
    flex-grow: 1;
}

.kit-hold {
    width: var(--size-button-min-w);
    margin-left: var(--space-xl);
    margin-right: var(--space-xl);
}

/* ---- W-20 pause (a W1 frame without categories) ---- */

.pause-shell {
    width: var(--size-pause-shell-w);
    height: var(--size-pause-shell-h);
}

.pause-seed {
    color: var(--color-muted);
    margin-bottom: var(--space-md);
}

.pause-rows {
    flex-grow: 1;
}

.pause-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-sm);
}

.pause-row .kit-button {
    width: var(--size-half-width);
}

.pause-hint {
    margin-left: var(--space-lg);
    color: var(--color-muted);
    font-size: var(--font-caption);
    flex-shrink: 1;
    white-space: normal;
}

.layout-narrow .pause-shell,
.band-compact .pause-shell {
    width: var(--size-full-width);
    height: var(--size-full-width);
}

.layout-narrow .pause-row .kit-button {
    width: var(--size-full-width);
}

.layout-narrow .pause-row {
    flex-direction: column;
    align-items: stretch;
}

.layout-narrow .pause-hint {
    margin-left: 0;
    margin-top: var(--space-xxs);
}

/* ---- W-08 rewards (W1t: the reward list beside its claim status; the card or draft pick as a sub-state) ---- */

.rewards-background {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-bg);
    background-size: cover;
    background-position-x: center;
    background-position-y: center;
}

.rewards-shell {
    width: var(--size-rewards-shell-w);
}

.rewards-status {
    flex-shrink: 0;
    margin-left: var(--space-lg);
    margin-right: var(--space-md);
    color: var(--color-parchment);
    font-size: var(--font-heading);
}

.rewards-body {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
}

.reward-scroll {
    flex-grow: 1;
    flex-shrink: 1;
}

.reward-list {
    flex-shrink: 0;
}

.reward-line {
    flex-direction: row;
    align-items: stretch;
    margin-bottom: var(--space-sm);
}

.reward-row {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    align-items: center;
    min-height: var(--size-reward-row-min-h);
    padding-top: var(--space-xs);
    padding-bottom: var(--space-xs);
    padding-left: var(--space-sm);
    padding-right: var(--space-sm);
    white-space: normal;
    -unity-text-align: middle-left;
}

.reward-icon {
    width: var(--size-reward-icon);
    height: var(--size-reward-icon);
    flex-shrink: 0;
    margin-right: var(--space-md);
    align-items: center;
    justify-content: center;
    background-size: contain;
    background-color: var(--color-bg-raise);
    border-radius: var(--radius-chip);
}

.reward-glyph {
    font-size: var(--font-glyph);
    color: var(--color-gold);
    -unity-text-align: middle-center;
}

.reward-texts {
    flex-grow: 1;
    flex-shrink: 1;
}

.reward-title {
    color: var(--color-parchment);
    -unity-font-style: bold;
    white-space: normal;
}

.reward-body {
    margin-top: var(--space-xxs);
    font-size: var(--font-caption);
    color: var(--color-muted);
    white-space: normal;
}

.reward-chip {
    flex-shrink: 0;
    min-width: var(--size-reward-chip-min-w);
    margin-left: var(--space-md);
    padding: var(--space-xxs) var(--space-sm);
    font-size: var(--font-chip);
    color: var(--color-parchment);
    background-color: var(--color-bg-raise);
    border-radius: var(--radius-chip);
    -unity-text-align: middle-center;
}

.reward-row--taken .reward-chip {
    color: var(--color-green);
}

.reward-row--blocked .reward-chip,
.reward-row--skipped .reward-chip {
    color: var(--color-muted);
}

.reward-row:focus .reward-title,
.reward-row:hover .reward-title {
    color: var(--color-gold);
}

.reward-row:disabled {
    opacity: var(--opacity-muted);
}

.reward-skip {
    flex-shrink: 0;
    width: var(--size-reward-skip-w);
    margin-left: var(--space-sm);
}

.claim-status {
    width: var(--size-claim-status-w);
    flex-shrink: 0;
    margin-left: var(--space-xl);
    padding-left: var(--space-lg);
    border-left-width: var(--border-hairline);
    border-color: var(--color-line);
}

.claim-list {
    margin-top: var(--space-sm);
}

.claim-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: var(--space-xs);
}

.claim-name {
    flex-shrink: 1;
    margin-right: var(--space-sm);
    font-size: var(--font-caption);
    white-space: normal;
}

.claim-state {
    flex-shrink: 0;
    font-size: var(--font-caption);
    color: var(--color-muted);
}

.claim-row.reward-row--taken .claim-state {
    color: var(--color-green);
}

.claim-required {
    margin-top: var(--space-md);
    color: var(--color-gold);
    font-size: var(--font-caption);
    white-space: normal;
}

.rewards-hint {
    margin-top: var(--space-md);
    color: var(--color-muted);
    font-size: var(--font-caption);
    white-space: normal;
}

.reward-pick {
    flex-grow: 1;
    flex-shrink: 1;
}

.pick-title {
    font-size: var(--font-heading);
    color: var(--color-gold);
    -unity-font-style: bold;
    white-space: normal;
}

.pick-prompt {
    margin-top: var(--space-xs);
    color: var(--color-muted);
}

.pick-cards {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
}

.pick-cards .pick-card {
    width: var(--size-pick-card-w);
    height: var(--size-pick-card-h);
    margin: var(--space-md);
}

.pick-node {
    width: var(--size-pick-node-w);
    min-height: var(--size-pick-node-h);
    margin: var(--space-md);
    white-space: normal;
    -unity-text-align: middle-center;
}

.pick-selected,
.pick-card.card--chosen {
    border-color: var(--color-ready-line);
    border-width: var(--border-glow);
}

.pick-footer {
    flex-direction: row;
    align-items: center;
    min-height: var(--size-button-h);
}

.pick-gap {
    flex-grow: 1;
}

.pick-button {
    width: var(--size-third-width);
}

.pick-skip {
    margin-left: var(--space-sm);
}

/* Continue stays green once every row is resolved, with the focus glow on top (04 W-08). */
.rewards-shell .unity-button.kit-button--ready:focus:enabled,
.rewards-shell .unity-button.kit-button--ready:hover:enabled {
    background-color: var(--color-ready);
    color: var(--color-parchment);
}

.band-compact .reward-row {
    min-height: var(--size-button-h);
}

.band-compact .reward-body {
    display: none;
}

.band-compact .rewards-status {
    font-size: var(--font-body);
}

.band-compact .pick-cards .pick-card {
    width: var(--size-pick-card-compact-w);
    height: var(--size-pick-card-compact-h);
    margin: var(--space-xs);
}

.band-compact .claim-row {
    flex-direction: column;
}

.band-compact .claim-status {
    margin-left: var(--space-md);
    padding-left: var(--space-md);
}

.layout-narrow .rewards-shell {
    width: var(--size-full-width);
}

.layout-narrow .rewards-body {
    flex-direction: column;
}

.layout-narrow .claim-status {
    width: var(--size-full-width);
    margin-left: 0;
    margin-top: var(--space-md);
    padding-left: 0;
    padding-top: var(--space-sm);
    border-left-width: 0;
    border-top-width: var(--border-hairline);
}

.layout-narrow .reward-chip {
    min-width: 0;
}

.layout-narrow .pick-cards .pick-card {
    width: var(--size-card-narrow-w);
    height: var(--size-card-narrow-h);
    margin: var(--space-xs);
}

.layout-narrow .pick-button {
    width: var(--size-third-width);
}
