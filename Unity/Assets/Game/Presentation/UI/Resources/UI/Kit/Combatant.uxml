<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="Combatant.uss" />
    <Ashen.Presentation.UI.LocLabel name="COMBATANT_INTENT" class="combatant-intent kit-text-value" picking-mode="Ignore" />
    <ui:VisualElement name="COMBATANT_ART" class="combatant-art" picking-mode="Ignore">
        <Ashen.Presentation.UI.LocLabel name="COMBATANT_BLOCK" class="combatant-block kit-text-value" picking-mode="Ignore" />
        <Ashen.Presentation.UI.LocLabel name="COMBATANT_BADGE" class="combatant-badge kit-text-value" picking-mode="Ignore" />
    </ui:VisualElement>
    <Ashen.Presentation.UI.LocLabel name="COMBATANT_NAME" class="combatant-name kit-text-value" picking-mode="Ignore" />
    <Ashen.Presentation.UI.LocLabel name="COMBATANT_PREVIEW" class="combatant-preview kit-text-value" picking-mode="Ignore" />
    <Ashen.Presentation.UI.Kit.Meter name="COMBATANT_HP" class="combatant-meter" kind="hp" picking-mode="Ignore" />
    <ui:VisualElement name="COMBATANT_BREAK" class="combatant-break" picking-mode="Ignore">
        <Ashen.Presentation.UI.Kit.Meter name="COMBATANT_POISE" class="combatant-meter combatant-meter--small" kind="poise" glyph-key="resource.poise.name" picking-mode="Ignore" />
        <Ashen.Presentation.UI.Kit.Meter name="COMBATANT_WARD" class="combatant-meter combatant-meter--small" kind="ward" glyph-key="resource.ward.name" picking-mode="Ignore" />
    </ui:VisualElement>
    <Ashen.Presentation.UI.LocLabel name="COMBATANT_STANCE" class="combatant-stance kit-text-value" picking-mode="Ignore" />
    <ui:VisualElement name="COMBATANT_STATUSES" class="combatant-statuses" picking-mode="Ignore" />
</ui:UXML>
