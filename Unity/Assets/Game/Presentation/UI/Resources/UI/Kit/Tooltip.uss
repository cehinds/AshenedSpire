/* Tooltip (docs/design/04 §0): sizes WT0-WT3; shown after the tooltip delay. */
.tooltip {
    position: absolute;
    padding: var(--space-sm) var(--space-md);
    background-color: var(--color-panel);
    border-color: var(--color-gold);
    border-width: var(--border-hairline);
    border-radius: var(--radius-chip);
    opacity: 0;
    transition-property: opacity;
    transition-duration: var(--duration-fast);
}

.tooltip--visible {
    opacity: 1;
}

.tooltip--wt0 { width: var(--size-tooltip-wt0); }
.tooltip--wt1 { width: var(--size-tooltip-wt1); }
.tooltip--wt2 { width: var(--size-tooltip-wt2); }
.tooltip--wt3 { width: var(--size-tooltip-wt3); }

.tooltip--wt0 .tooltip-body {
    display: none;
}

.tooltip-head {
    flex-direction: row;
    align-items: center;
}

.tooltip-glyph {
    margin-right: var(--space-xs);
    color: var(--color-gold);
    font-size: var(--font-heading);
}

.tooltip-title {
    color: var(--color-gold);
    font-size: var(--font-body);
    -unity-font-style: bold;
}

.tooltip-body {
    margin-top: var(--space-xxs);
    font-size: var(--font-caption);
    white-space: normal;
}

/* The arrow (kit.css:697-711): a 7.5 x 3.75 gold triangle on the edge that faces the trigger, pointing at its centre. The tooltip sits
   under its trigger, so it is on the top edge; Tooltip.cs sets its left (this left is the inset from the corner). It lies outside the
   panel: the top offset is its height plus the 1 px border. */
.tooltip-arrow {
    position: absolute;
    left: var(--size-tooltip-arrow-inset);
    top: var(--size-tooltip-arrow-top);
    width: var(--size-tooltip-arrow-w);
    height: var(--size-tooltip-arrow-h);
    background-image: url("../Frames/tooltip-arrow.png");
}

/* The arrow turns to the edge that faces the trigger (tooltip.js pointArrow): the sprite points up, which is the top edge (the tooltip under its trigger). */
.tooltip--arrow-bottom {
    rotate: var(--ratio-tooltip-turn-bottom);
}

.tooltip--arrow-left {
    rotate: var(--ratio-tooltip-turn-left);
}

.tooltip--arrow-right {
    rotate: var(--ratio-tooltip-turn-right);
}
