/* Rule 11 CategoryNav (docs/design/04 §0): rail or [Category ▾] selector, toggled by class. No tabs, no accordions. */
.categorynav {
    flex-shrink: 0;
}

.nav--rail .nav-selector,
.nav--rail .nav-selector-list {
    display: none;
}

.nav--selector .nav-rail {
    display: none;
}

.nav--rail .nav-step {
    display: none;
}

.nav-rail {
    width: var(--size-rail-width);
    padding-right: var(--space-md);
    border-right-width: var(--border-hairline);
    border-color: var(--color-line);
}

.nav-selector {
    width: var(--size-selector-width);
    -unity-text-align: middle-left;
}

.nav-selector-list {
    display: none;
    position: absolute;
    top: var(--size-button-h);
    left: 0;
    width: var(--size-selector-width);
    padding: var(--space-xs);
    background-color: var(--color-bg-raise);
    border-color: var(--color-gold-soft);
    border-width: var(--border-hairline);
}

.nav--open .nav-selector-list {
    display: flex;
}

.nav-item {
    margin-bottom: var(--space-xs);
    -unity-text-align: middle-left;
}

.nav-item.is-selected {
    border-color: var(--color-gold);
    color: var(--color-gold);
}

/* The phone's stepper (VP-16, D-1203; creation flow-05 / flow-06 -390x844.jpg): a green step button ("1 of 2 · Class") beside the gold "All steps" select, one row.
   The step is a label (the select's list picks the step), so it takes no focus. */
.nav--selector.nav--stepped {
    flex-direction: row;
    align-items: stretch;
}

.nav-step {
    flex-grow: 1;
    flex-basis: 0;
    min-height: var(--size-nav-step-h);
    margin: 0 var(--space-md) 0 0;
    padding: 0 var(--space-md);
    background-color: var(--color-ready);
    border-color: var(--color-ready-line);
    border-width: var(--border-hairline);
    border-radius: var(--radius-button);
    color: var(--color-ready-text);
    font-size: var(--font-button);
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
}

.nav--stepped .nav-selector {
    flex-grow: 0;
    width: var(--size-nav-all-steps-w);
    min-height: var(--size-nav-step-h);
    border-color: var(--color-gold);
    color: var(--color-gold);
}

.nav--stepped .nav-selector-list {
    top: var(--size-nav-step-h);
    left: auto;
    right: 0;
    width: var(--size-nav-all-steps-w);
}
