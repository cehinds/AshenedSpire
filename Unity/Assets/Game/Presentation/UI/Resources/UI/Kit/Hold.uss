/* Hold-to-confirm (docs/design/04 §0): the label, the stripe fill behind it and its text equivalent. */
.holdbutton {
    flex-direction: column;
    justify-content: center;
    align-items: stretch;
    padding-top: var(--space-xs);
    padding-bottom: var(--space-xs);
}

.hold-label {
    font-size: var(--font-button);
    -unity-text-align: middle-center;
    color: var(--color-parchment);
}

/* The fill (kit.css:2883-2891): the web paints the hold as a light / dark diagonal stripe BEHIND the control's own label, growing from the
   left to 100% of the control. It is the first child (drawn under the label), absolutely placed over the whole button, and HoldButton sets
   its width in percent. The stripe is a seamless tile (Frames/hold-stripe.png, Tools/ui-frames.mjs). */
.hold-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background-image: url("../Frames/hold-stripe.png");
    background-repeat: repeat;
    background-size: var(--size-hold-stripe) var(--size-hold-stripe);
    background-position-x: left;
    background-position-y: top;
}

/* The web's hold hint (kit.css:2893): small, wide-tracked, gold at 75%. Upper-cased by kit-upper in Hold.uxml. */
.hold-state {
    font-size: var(--font-hold-hint);
    letter-spacing: var(--size-track-hold);
    -unity-text-align: middle-center;
    color: var(--color-gold);
    opacity: var(--opacity-muted);
}

/* The control wears the gold edge while it is held (kit.css:2898). */
.holdbutton.is-holding {
    border-color: var(--color-gold);
}
