<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="Tooltip.uss" />
    <ui:VisualElement class="tooltip-head" picking-mode="Ignore">
        <Ashen.Presentation.UI.LocLabel name="TOOLTIP_GLYPH" class="tooltip-glyph is-hidden" picking-mode="Ignore" />
        <Ashen.Presentation.UI.LocLabel name="TOOLTIP_TITLE" class="tooltip-title kit-text-header" picking-mode="Ignore" />
    </ui:VisualElement>
    <Ashen.Presentation.UI.LocLabel name="TOOLTIP_BODY" class="tooltip-body kit-text-value" picking-mode="Ignore" />
</ui:UXML>
