/* Shared panel chrome (VP-11, D-600): 9-slice frames, soft shadows, divider, chips and scroll bars. The sprites in Frames/
   are rendered from the web's own SVG/CSS by Tools/ui-frames.mjs; their 9-slice borders live in the sprite import (.meta).
   Frames and plates are drawn at 2 texels per reference px (slice scale 0.5), the shadows at half density (slice scale 2).
   Web: panel frame styles/player-polish.css:30, modal shell styles/kit.css:445-452, tooltip kit.css:684-696. */

/* ---- soft drop shadow: an absolutely placed first child of the panel (USS has no box-shadow). The sprite has its middle
        cut out, like CSS, so the panel's own fill is untouched. The offsets are the blur reach and y offset. ---- */

.shadow-plate {
    position: absolute;
    left: var(--size-modal-shadow-side);
    right: var(--size-modal-shadow-side);
    top: var(--size-modal-shadow-top);
    bottom: var(--size-modal-shadow-bottom);
    background-image: url("../Frames/modal-shadow.png");
    -unity-slice-scale: var(--size-slice-soft);
}

.shadow-plate--tooltip {
    left: var(--size-tooltip-shadow-side);
    right: var(--size-tooltip-shadow-side);
    top: var(--size-tooltip-shadow-top);
    bottom: var(--size-tooltip-shadow-bottom);
    background-image: url("../Frames/tooltip-shadow.png");
}

/* ---- frames: brass hairline with corner brackets. The element keeps a transparent 1 px border for layout and
        highlights (hover/focus recolour it); the sprite is the visible edge. ---- */

.kit-frame {
    border-width: var(--border-hairline);
    border-color: var(--color-transparent);
    border-radius: var(--radius-tight);
    background-image: url("../Frames/panel-frame.png");
    -unity-slice-scale: var(--size-slice-frame);
}

.kit-frame--modal {
    background-image: url("../Frames/modal-frame.png");
}

/* ---- ornate divider (player-polish.css:41-43): 12 px high, stretched to the width ---- */

.kit-divider {
    height: var(--size-divider-h);
    background-image: url("../Frames/divider-ornate.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* ---- chips: the web's StatePill (kit.css:254-262): hairline, 3 px corner, small tracked muted caps; "on" is gold ---- */

.kit-chip {
    padding: var(--size-chip-pad-y) var(--size-chip-pad-x);
    margin: 0;
    border-width: var(--border-hairline);
    border-color: var(--color-line-soft);
    border-radius: var(--radius-tight);
    color: var(--color-muted);
    font-size: var(--font-pill);
    letter-spacing: var(--size-track-chip);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.kit-chip--on {
    border-color: var(--color-gold);
    color: var(--color-gold);
}

.kit-chip--round {
    border-radius: var(--radius-pill);
}

/* ---- the focus ring (base.css:376-389, kit.css:2533): 2 px gold, drawn outside the control, for a key or pad cursor only. FocusRing.cs
        places the root over the focused control; the box reaches past it by the offset plus the stroke (size.focusRingReach, negative) ---- */

.focus-ring {
    position: absolute;
}

.focus-ring-box {
    position: absolute;
    left: var(--size-focus-ring-reach);
    top: var(--size-focus-ring-reach);
    right: var(--size-focus-ring-reach);
    bottom: var(--size-focus-ring-reach);
    border-width: var(--border-focus);
    border-color: var(--color-gold);
    border-radius: var(--radius-tight);
}

/* ---- the select (VP-16, D-1204): the web's native select as a dark face with the chosen words and a chevron; its list opens in place
        (Kit/SelectField.cs) so the settings' scroll view cannot clip it and the options stay in the screen's focus order ---- */

.kit-select {
    flex-direction: column;
    align-self: stretch;
}

.kit-select-face.kit-button {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: var(--size-select-h);
    padding: 0 var(--space-md);
    background-color: var(--color-bg-raise);
    background-image: none;
    border-color: var(--color-line-soft);
    border-radius: var(--radius-button);
    -unity-text-align: middle-left;
}

.kit-select-face.kit-button:hover,
.kit-select-face.kit-button:focus {
    background-color: var(--color-bg-raise);
}

.kit-select-value {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
    font-size: var(--font-body);
    color: var(--color-parchment);
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.kit-select-chevron {
    flex-shrink: 0;
    width: var(--size-select-chevron-w);
    margin: 0;
    font-size: var(--font-body);
    color: var(--color-muted);
    -unity-text-align: middle-center;
}

.kit-select-list {
    display: none;
    flex-direction: column;
    margin-top: var(--space-xxs);
    padding: var(--space-xxs);
    background-color: var(--color-bg-raise);
    border-width: var(--border-hairline);
    border-color: var(--color-gold-soft);
    border-radius: var(--radius-button);
}

.kit-select.nav--open .kit-select-list {
    display: flex;
}

.kit-select-option.kit-button {
    min-height: var(--size-select-h);
    margin: 0;
    padding: 0 var(--space-md);
    background-color: var(--color-transparent);
    background-image: none;
    border-color: var(--color-transparent);
    -unity-text-align: middle-left;
}

.kit-select-option.kit-button:hover,
.kit-select-option.kit-button:focus {
    background-color: var(--color-panel-raise);
}

.kit-select-option.is-selected {
    color: var(--color-gold);
}

.layout-narrow .kit-select-face.kit-button,
.layout-narrow .kit-select-option.kit-button {
    min-height: var(--size-select-narrow-h);
}

/* ---- scroll bars (kit.css:673-679): 8 px, thin line-soft thumb with a 4 px corner on a transparent track, no arrows ---- */

.unity-scroll-view .unity-scroller {
    background-color: var(--color-transparent);
    border-width: 0;
}

.unity-scroll-view .unity-scroller--vertical {
    width: var(--size-scrollbar-w);
}

.unity-scroll-view .unity-scroller--horizontal {
    height: var(--size-scrollbar-w);
}

.unity-scroll-view .unity-scroller .unity-repeat-button {
    display: none;
}

.unity-scroll-view .unity-scroller .unity-base-slider__tracker {
    background-color: var(--color-transparent);
    border-width: 0;
}

.unity-scroll-view .unity-scroller .unity-base-slider__dragger {
    background-color: var(--color-line-soft);
    border-width: 0;
    border-radius: var(--radius-scroll-thumb);
}

.unity-scroll-view .unity-scroller .unity-base-slider__dragger:hover {
    background-color: var(--color-gold-soft);
}
