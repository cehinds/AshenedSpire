{
  "$id": "rules/runFlow.json",
  "type": "object",
  "properties": {
    "autosave": {
      "type": "object",
      "properties": {
        "afterCommand": {
          "type": "string",
          "enum": [
            "append",
            "checkpoint",
            "none"
          ]
        },
        "checkpointOn": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "endTurn",
              "playCard",
              "useFlask"
            ]
          }
        }
      },
      "required": [
        "afterCommand",
        "checkpointOn"
      ]
    },
    "comment": {
      "type": "string"
    },
    "creation": {
      "type": "object",
      "properties": {
        "defaultClass": {
          "type": "string",
          "x-ref": "catalog/classes.json"
        },
        "defaultTint": {
          "type": "string"
        },
        "journey": {
          "type": "string"
        },
        "nameKey": {
          "type": "string"
        },
        "portrait": {
          "type": "string"
        }
      },
      "required": [
        "defaultClass",
        "defaultTint",
        "journey",
        "nameKey",
        "portrait"
      ]
    },
    "firstFight": {
      "type": "object",
      "properties": {
        "ordinal": {
          "type": "integer"
        },
        "pool": {
          "type": "string",
          "enum": [
            "normal",
            "elite",
            "boss"
          ]
        },
        "seat": {
          "type": "string",
          "x-ref": "catalog/seats.json"
        }
      },
      "required": [
        "ordinal",
        "pool",
        "seat"
      ]
    },
    "saveFormat": {
      "type": "integer"
    },
    "newRun": {
      "type": "object",
      "properties": {
        "customization": {
          "type": "object",
          "properties": {
            "glyph": {
              "type": "string"
            }
          },
          "required": [
            "glyph"
          ]
        },
        "advancedConfigSnapshot": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "integer"
            },
            "ratingsVersion": {
              "type": "integer"
            },
            "overrides": {
              "type": "object"
            }
          },
          "required": [
            "schemaVersion",
            "ratingsVersion",
            "overrides"
          ]
        },
        "prologue": {
          "type": "boolean"
        }
      },
      "required": [
        "customization",
        "advancedConfigSnapshot",
        "prologue"
      ]
    },
    "settings": {
      "type": "object",
      "properties": {
        "multiUse": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "def": {
              "type": "boolean"
            }
          },
          "required": [
            "key"
          ]
        },
        "shopSell": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "def": {
              "type": "boolean"
            }
          },
          "required": [
            "key"
          ]
        },
        "holdConfirm": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            }
          },
          "required": [
            "key"
          ]
        }
      },
      "required": [
        "multiUse",
        "shopSell",
        "holdConfirm"
      ]
    },
    "screens": {
      "type": "object",
      "properties": {
        "combat": {
          "type": "string"
        },
        "rewards": {
          "type": "string"
        },
        "map": {
          "type": "string"
        },
        "rest": {
          "type": "string"
        },
        "merchant": {
          "type": "string"
        },
        "event": {
          "type": "string"
        },
        "dungeon": {
          "type": "string"
        },
        "runEnd": {
          "type": "string"
        }
      },
      "required": [
        "combat",
        "rewards",
        "map",
        "rest",
        "merchant",
        "event",
        "dungeon",
        "runEnd"
      ]
    }
  },
  "required": [
    "autosave",
    "comment",
    "creation",
    "firstFight",
    "newRun",
    "saveFormat",
    "screens",
    "settings"
  ]
}
