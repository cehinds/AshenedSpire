      "focusOrder": [],
      "back": null,
      "transitions": {
        "ready": { "to": "title", "mode": "replace" },
        "failed": { "to": "contentError", "mode": "replace" },
        "recovery": { "to": "profileRecovery", "mode": "replace" }
      }
    },
    "contentError": {
