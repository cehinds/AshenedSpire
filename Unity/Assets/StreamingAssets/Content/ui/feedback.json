    "pace": "src/ui/animationPace.js:6-11 (ANIM_SPEEDS), :15-22 (COMBAT_TIMING), :26-28 (turnBannerHoldMs), :65-82 (actionPacing); content/config/ui/presentation/actionPacing.json motion; setAnimSpeed falls back to normal (animationPace.js:31-33), so the setting 'auto' plays at normal",
    "feel": "src/content/combatFeel.js:23-43 (shake steps, hit-stop), src/ui/fx.js:715-732 (shake 200 ms, the stagger's fixed 4 px)",
    "float": "src/ui/fx.js:364-416 floatNum (centre + x + jitter +-13, top = box top + 0.25 x height + y, clamp pad 6, removed after 600 ms), :646-655 dmgClass, :1869-1930 the offsets of the damageDealt numbers",
