{
  "comment": "Cross-table references for schema bootstrap (Tools/infer-schemas.mjs) and the validator. 'path' is a regex over the inference path (<file-as-dots>.<field>[.<field>…], arrays add []). An empty string value counts as 'no reference'.",
  "refs": [
    { "path": "^profile\\.bundle\\.encounters\\.enemies\\[\\]$", "table": "profile/bundle/enemies.json" },
    { "path": "^profile\\.bundle\\.encounters\\.seat$", "table": "profile/bundle/seats.json" },
    { "path": "^profile\\.bundle\\.classes\\.(abilityCard|startingSignatureCard)$", "table": "profile/bundle/cards.json" },
    { "path": "^profile\\.bundle\\.classes\\.cardPool\\[\\]$", "table": "profile/bundle/cards.json" },
    { "path": "^profile\\.bundle\\.classes\\.(startingRelic|kitRelic)$", "table": "profile/bundle/relics.json" },
    { "path": "^profile\\.bundle\\.startingKits\\.(rightHand|leftHand)$", "table": "profile/bundle/armaments.json" },
    { "path": "^profile\\.bundle\\.(startingKits|armour|classTree)\\.classId$", "table": "profile/bundle/classes.json" },
    { "path": "^profile\\.(bundle|content)\\..*\\.effects\\[\\]\\.status$", "table": "profile/bundle/statuses.json" },
    { "path": "^profile\\.(bundle|content)\\..*\\.effects\\[\\]\\.stance$", "table": "profile/bundle/stances.json" }
  ],
  "mapPaths": [
    "profile.bundle.enemies.moves",
    "profile.bundle.eventMeta.eventChoiceIds",
    "profile.bundle.balance.combatRatings.enemyAttackType",
    "profile.bundle.balance.combatRatings.itemRatings",
    "rules.rewardsEngine.flasks.legacyChargeKindById",
    "ui.screens.screens",
    "ui.screens.screens.*.transitions",
    "ui.menus.confirms"
  ],
  "freeText": ["icon", "art", "tint", "glyph", "color", "flavor", "name", "text", "label", "blurb", "aside", "template", "textTemplate", "tooltip", "description", "artKey", "artAsset", "portraitKey", "cardTint"]
}
