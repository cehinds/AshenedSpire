  "keySets": [
    {
      "name": "RunFlowKeys",
      "doc": "Keys of rules/runFlow.json (Ashen.App.Run.RunFlowRules).",
      "keys": {
        "SaveFormat": "saveFormat",
        "Creation": "creation",
        "DefaultClass": "defaultClass",
        "DefaultTint": "defaultTint",
        "Portrait": "portrait",
        "Journey": "journey",
        "NameKey": "nameKey",
        "FirstFight": "firstFight",
        "Seat": "seat",
        "Pool": "pool",
        "Ordinal": "ordinal",
        "Autosave": "autosave",
        "AfterCommand": "afterCommand",
        "CheckpointOn": "checkpointOn",
        "RegionId": "regionId",
        "SeedRules": "seed",
        "Alphabet": "alphabet",
        "Homoglyphs": "homoglyphs",
        "MaxLength": "maxLength",
        "Name": "name",
        "Tint": "tint",
        "Ui": "ui",
        "RewardCollect": "rewardCollect",
        "Modes": "modes",
        "Def": "def",
        "LevelUpValue": "levelUpValue",
        "NewRun": "newRun",
        "AscensionOrder": "ASCENSION_ORDER",
        "State": "state",
        "Claimed": "claimed",
        "Skipped": "skipped",
        "Available": "available",
        "RequiredChoice": "requiredChoice",
        "Rows": "rows",
        "StoneBalanceAfter": "stoneBalanceAfter",
        "Label": "label",
        "Blurb": "blurb",
        "Tag": "tag",
        "From": "from",
        "Suffix": "suffix",
        "Value": "value",
        "ArtKey": "artKey"
      }
    },
    {
      "name": "RunSaveKeys",
      "doc": "Keys of a run save payload (RunSession.Save): the format, preset, slot summary (SlotSummaryKeys), run document, location, encounter and combat checkpoint.",
      "keys": {
        "FormatVersion": "formatVersion",
        "PresetId": "presetId",
        "Run": "run",
        "Location": "location",
        "EncounterId": "encounterId",
        "Combat": "combat",
        "Name": "name",
        "Portrait": "portrait",
        "Playtime": "playtimeSeconds",
        "After": "after"
      }
    },
    {
      "name": "RunFlowValues",
      "doc": "Wire values of rules/runFlow.json and the run save payload.",
      "keys": {
        "LocationCombat": "combat",
        "AutosaveAppend": "append",
        "AutosaveCheckpoint": "checkpoint",
        "AutosaveNone": "none",
        "PlaceholderClass": "class",
        "PlaceholderTint": "tint",
        "SavedAtFormat": "yyyy-MM-dd'T'HH:mm:ss'Z'",
        "LocationRewards": "rewards",
        "LocationMap": "map",
        "StateBlocked": "blocked",
        "StateAvailable": "available",
        "StateChoice": "choice",
        "RefusalClaimed": "claimed",
        "RefusalBlocked": "blocked",
        "RefusalSpent": "spent",
        "RefusalNoRoom": "noRoom",
        "RefusalNoPick": "noPick",
        "RefusalNotOffered": "notOffered",
        "RefusalNoSuchRow": "noSuchRow",
        "RefusalNoReward": "noReward",
        "RefusalRefused": "refused"
      }
    },
    {
      "name": "RunFlowMessages",
      "doc": "Developer-facing run-flow messages (exceptions and warnings; never shown to players).",
      "keys": {
        "NoFirstFight": "run: no encounter for seat '{0}' pool '{1}' at ordinal {2}",
        "UnknownClass": "run: unknown class '{0}'",
        "NotInCombat": "run: the run is not in a fight",
        "FormatMismatch": "run: slot '{0}' holds run format {1}; this build reads {2}",
        "ContentChanged": "run: content changed since the save (saved {0}, now {1}); resumed from the checkpoint without replaying the log",
        "LogDiverged": "run: the command log diverged after {0} commands; resumed at the last verified state",
        "LoadRefused": "run: slot '{0}' could not be loaded ({1})",
        "NoPendingReward": "run: the run holds no pending reward"
      }
    }
  ]
}
