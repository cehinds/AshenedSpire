{
  "comment": "Asset ID rules (US-0.1, PF-01). Each rule maps a source path (relative to the shipped repo, regex) to a dotted asset ID template ($1.. = groups; {lower:$n} lower-cases a group). First match wins. Unmatched files under 'roots' are orphans (reported, never shipped). 'import' lists the ID prefixes converted into Unity in the current phase (D-035: disk-constrained, phase-by-phase import).",
  "roots": ["assets", "art/relic-icons-pack-01/webp", "art/relic-icons-pack-02/webp", "art/relic-icons-pack-03/webp"],
  "ignore": ["\\.(json|md|mjs|py|txt)$", "^assets/classes/", "^assets/components/"],
  "rules": [
    { "match": "^assets/sprites/(reaver|rogue|starseer|herald)_(ember|frost|gold|grace|rot)\\.webp$", "id": "class.$1.sprite.$2" },
    { "match": "^assets/sprites/enemy_(\\w+)\\.webp$", "id": "enemy.$1.base" },
    { "match": "^assets/enemies-expansion/(\\w+)\\.webp$", "id": "enemy.$1.base" },
    { "match": "^assets/enemies-unity/painted_(\\w+)\\.webp$", "id": "enemy.$1.painted" },
    { "match": "^assets/enemy-states/(\\w+)_(\\w+)\\.webp$", "id": "enemy.$1.state.$2" },
    { "match": "^assets/enemy-poses/(\\w+)_(attack|idle)\\.webp$", "id": "enemy.$1.pose.$2" },
    { "match": "^assets/defeated-poses/([\\w-]+)\\.webp$", "id": "defeated.$1" },
    { "match": "^assets/combat-effects/([A-Za-z]+)(\\d+)\\.webp$", "id": "vfx.$1.$2" },
    { "match": "^assets/pose-effects/([A-Za-z]+)(\\d+)\\.webp$", "id": "posefx.$1.$2" },
    { "match": "^assets/animations/reaver/default-greatsword/right/(F\\d+)\\.webp$", "id": "anim.reaver.defaultGreatsword.{lower:$1}" },
    { "match": "^assets/animations/([\\w-]+)/([\\w-]+)/([A-Z0-9-]+)\\.webp$", "id": "anim.$1.$2.{lower:$3}" },
    { "match": "^assets/poses/([\\w-]+)_(\\w+)_(ember|frost|gold|grace|rot)\\.webp$", "id": "pose.$1.$2.$3" },
    { "match": "^assets/painted-outfits/([\\w-]+)/(\\w+)\\.webp$", "id": "outfit.$1.$2" },
    { "match": "^assets/readiness-poses/([\\w-]+)/(\\w+)\\.webp$", "id": "readiness.$1.$2" },
    { "match": "^assets/equipment/components/v1/(\\w+)/(\\w+)\\.webp$", "id": "equipment.part.$2" },
    { "match": "^assets/equipment/(body|icon|weapon)_(\\w+)\\.webp$", "id": "equipment.$1.$2" },
    { "match": "^assets/relics/(\\w+)\\.webp$", "id": "relic.$1" },
    { "match": "^art/relic-icons-pack-0\\d/webp/(\\w+)-(\\d+)\\.webp$", "id": "relic.$1.icon$2" },
    { "match": "^assets/ui/flasks/flask-(\\w+)\\.webp$", "id": "flask.$1" },
    { "match": "^assets/environments/legacy/([\\w-]+)\\.webp$", "id": "env.legacy.$1" },
    { "match": "^assets/environments/([\\w-]+)\\.webp$", "id": "env.$1" },
    { "match": "^assets/bg/([\\w-]+)\\.(webp|svg)$", "id": "bg.$1" },
    { "match": "^assets/map/parchment_act(\\d)\\.svg$", "id": "map.parchment.act$1" },
    { "match": "^assets/prologue/([\\w-]+)\\.webp$", "id": "prologue.$1" },
    { "match": "^assets/framework/(missing)\\.svg$", "id": "framework.$1" }
  ],
  "import": ["flask.", "class.", "enemy.", "vfx.", "bg.", "env.", "map.", "framework.", "relic.", "equipment.icon.", "defeated.", "pose.", "posefx."],
  "release": {
    "comment": "VP-2 art-release pass (node Tools/scan-assets.mjs --release <dir>; D-550..D-553). <dir> is the web's .art-cache/<tag> (high/ and common/, fetched by its tools/fetch-art.mjs) so the paths below are relative to each pack. Rules are first-match like the top-level ones, and only ADD ids (an id that already has a committed Unity import is kept). 'convert' decides what is imported into Unity (first match on the id): format png (alpha) or jpg (opaque, quality), maxWidth/maxHeight fit inside without enlarging, scale/svgSize rasterise an SVG (svgColor replaces currentColor so the glyph is white and USS tints it), flat puts the file straight under its domain folder. An id with no convert entry is registered but not imported (later phase). 'maps' names the map-detail hash folders (src/content/mapArt.generated.js). 'web' roots are tracked files of the web repo itself (--web).",
    "tag": "hd-assets-v23",
    "packs": {
      "high": { "dir": "high", "roots": ["assets"] },
      "common": { "dir": "common", "roots": ["map-detail"] }
    },
    "web": { "roots": ["assets-display/card-cutouts", "assets-display/alternative", "assets-mobile/enemy-poses/expansion", "assets-mobile/animations/player-counter-sweep", "assets-mobile/animations/greatsword-outfits/reaver", "assets-mobile/animations/twin-sword-outfits/rogue", "assets-mobile/animations/unarmed/herald", "assets-mobile/animations/unarmed-magic/starseer"] },
    "ignore": ["\\.(json|md|mjs|py|txt)$", "^assets/(fonts|classes|components)/", "^assets/animations/(?!player-counter-sweep/|(?:greatsword-outfits/reaver|twin-sword-outfits/rogue|unarmed/herald|unarmed-magic/starseer)/HURT\\.webp$)", "^assets/enemy-poses/(?!expansion/)", "^assets-mobile/animations/(?!player-counter-sweep/|(?:greatsword-outfits/reaver|twin-sword-outfits/rogue|unarmed/herald|unarmed-magic/starseer)/HURT\\.webp$)"],
    "maps": {
      "c0903c6d0ba56c76": "the-fractured-realm-world", "3517e178c334eab2": "the-shattered-gulf-world", "0e7e9348271b9404": "the-fivefold-frontier-world",
      "86c695c4b0ca6fa1": "fractured-realm-square", "79596a876f5e4542": "ashen-crown-map", "ab38106f2796459a": "cinder-reach-map",
      "a5445ef5da3f35ac": "drowned-coast-map", "5dbce360375623fc": "hollow-weald-map", "2eab5c166d79e990": "pale-marches-map", "b70579a20d453cc2": "crownfall-local"
    },
    "rules": [
      { "match": "^assets/cards/extended/card-([A-Za-z0-9]+)-(512|1024)\\.webp$", "id": "card.$1.art$2" },
      { "match": "^assets/cards/library/(physical|magical)-(\\w+)-(\\d+)-(512|1024)\\.webp$", "id": "cardlib.$1-$2-$3.art$4" },
      { "match": "^assets/cards/extended/profile-(\\w+)-(512|1024)\\.webp$", "id": "cardprofile.$1.art$2" },
      { "match": "^assets/cards/([a-z-]+)-(512|1024)\\.webp$", "id": "cardofficial.$1.art$2" },
      { "match": "^assets/cards/default-outline/icons/([\\w-]+)\\.svg$", "id": "cardoutline.$1" },
      { "match": "^assets/card-components/1fe4ba7f330c67fca0a6\\.webp$", "id": "cardframe.base" },
      { "match": "^assets/card-components/44646e73c749cce0fd78\\.webp$", "id": "cardframe.art" },
      { "match": "^assets/card-components/0949257201425783d7c8\\.webp$", "id": "cardframe.panel" },
      { "match": "^assets/card-components/95887e9c269a4996cf95\\.webp$", "id": "cardframe.flag" },
      { "match": "^assets/card-components/3b925ecf740669106927\\.webp$", "id": "cardframe.energy" },
      { "match": "^assets/card-components/36cda4cba048ed38b0c9\\.webp$", "id": "cardframe.mana" },
      { "match": "^assets/card-components/f31ac0a1985194c9aa76\\.webp$", "id": "cardframe.stamina" },
      { "match": "^assets-display/card-cutouts/([\\w.-]+)\\.png$", "id": "cardcut.$1" },
      { "match": "^assets/ui-components/(armoury|menu)\\.webp$", "id": "uicomp.$1" },
      { "match": "^assets/ui/stamina-orb/(\\w+)\\.webp$", "id": "orb.$1" },
      { "match": "^assets/ui/footer/([\\w-]+)\\.webp$", "id": "footer.$1" },
      { "match": "^assets/ui/flasks/flask-(\\w+)\\.webp$", "id": "flask.$1" },
      { "match": "^assets/ui/ashen-blight-molten-river\\.webp$", "id": "bg.ashen-blight-molten-river" },
      { "match": "^assets/player-polish/ui/icons/([\\w-]+)\\.svg$", "id": "icon.$1" },
      { "match": "^assets/player-polish/ui/components/([\\w-]+)\\.svg$", "id": "uikit.$1" },
      { "match": "^assets/player-polish/ui/creation/([\\w-]+)\\.(webp|png)$", "id": "creation.$1" },
      { "match": "^assets/player-polish/scenes/([\\w-]+)\\.webp$", "id": "scene.$1" },
      { "match": "^assets/player-polish/illustrations/([\\w-]+)\\.webp$", "id": "illus.$1" },
      { "match": "^assets/player-polish/materials/([\\w-]+)\\.webp$", "id": "material.$1" },
      { "match": "^assets/events/(\\w+)\\.webp$", "id": "event.$1" },
      { "match": "^assets/portraits/(\\w+)\\.webp$", "id": "portrait.$1" },
      { "match": "^assets/shop/brass-button\\.webp$", "id": "shop.brass-button" },
      { "match": "^assets/shop/painted/(covers|symbols)/(\\w+)\\.webp$", "id": "shop.painted.$1.$2" },
      { "match": "^assets/shop/layers/covers/(\\w+)\\.webp$", "id": "shop.cover.$1" },
      { "match": "^assets/shop/layers/symbols/(\\w+)-(line|seal|solid)\\.svg$", "id": "shop.symbol.$1.$2" },
      { "match": "^assets/shop/layers/trims/(\\w+)\\.svg$", "id": "shop.trim.$1" },
      { "match": "^assets/shop/layers/cover-tint\\.svg$", "id": "shop.cover-tint" },
      { "match": "^assets/prologue/([\\w-]+)\\.webp$", "id": "prologue.$1" },
      { "match": "^map-detail/([0-9a-f]+)/(\\d+)/(\\d+)-(\\d+)\\.webp$", "id": "mapdetail.{maps:$1}.l$2.t$3x$4" },
      { "match": "^assets/poses/([\\w-]+)_(\\w+)_(ember|frost|gold|grace|rot)\\.webp$", "id": "pose.$1.$2.$3" },
      { "match": "^assets/pose-effects/([A-Za-z]+)(\\d+)\\.webp$", "id": "posefx.$1.$2" },
      { "match": "^assets-display/alternative/((?:card|class-smash|reaver-greatsword-pilot)-[\\w-]*?)(?<!-mobile)\\.webp$", "id": "alt.$1" },
      { "match": "^assets-display/alternative/stances/(\\w+)/(\\w+)\\.webp$", "id": "alt.stances.$1.$2" },
      { "match": "^assets/animations/player-counter-sweep/(\\w+)/(counter|sweep)/([\\w-]+)\\.webp$", "id": "sweep.$1.$2.$3" },
      { "match": "^assets/animations/(?:greatsword-outfits|twin-sword-outfits|unarmed|unarmed-magic)/(reaver|rogue|herald|starseer)/HURT\\.webp$", "id": "hurt.$1" },
      { "match": "^assets/enemy-poses/expansion/(\\w+)/([\\w-]+)\\.webp$", "id": "exp.$1.$2" },
      { "match": "^assets-mobile/enemy-poses/expansion/(\\w+)/([\\w-]+)\\.webp$", "id": "lite.exp.$1.$2" },
      { "match": "^assets-mobile/animations/player-counter-sweep/(\\w+)/(counter|sweep)/([\\w-]+)\\.webp$", "id": "lite.sweep.$1.$2.$3" },
      { "match": "^assets-mobile/animations/(?:greatsword-outfits|twin-sword-outfits|unarmed|unarmed-magic)/(reaver|rogue|herald|starseer)/HURT\\.webp$", "id": "lite.hurt.$1" }
    ],
    "convert": [
      { "match": "^card\\.\\w+\\.art512$", "format": "jpg", "quality": 86, "flat": true },
      { "match": "^cardlib\\.[\\w-]+\\.art512$", "format": "jpg", "quality": 86, "flat": true },
      { "match": "^cardprofile\\.\\w+\\.art512$", "format": "jpg", "quality": 86, "flat": true },
      { "match": "^cardcut\\.", "format": "png", "flat": true },
      { "match": "^cardframe\\.(base|flag|art)$", "format": "png", "maxWidth": 512 },
      { "match": "^cardframe\\.panel$", "format": "png", "maxWidth": 888 },
      { "match": "^cardframe\\.(energy|mana|stamina)$", "format": "png", "maxWidth": 256 },
      { "match": "^uicomp\\.", "format": "png", "maxWidth": 256 },
      { "match": "^(orb|footer|flask)\\.", "format": "png" },
      { "match": "^icon\\.", "format": "png", "svgSize": 128, "svgColor": "#ffffff", "flat": true },
      { "match": "^uikit\\.", "format": "png", "scale": 2 },
      { "match": "^creation\\.", "format": "png" },
      { "match": "^scene\\.", "format": "jpg", "quality": 85, "maxWidth": 1920, "maxHeight": 1920 },
      { "match": "^illus\\.card-", "format": "jpg", "quality": 85, "maxWidth": 1024 },
      { "match": "^illus\\.", "format": "png", "maxWidth": 1024 },
      { "match": "^event\\.", "format": "png" },
      { "match": "^portrait\\.", "format": "png" },
      { "match": "^shop\\.painted\\.", "format": "png", "maxWidth": 320 },
      { "match": "^shop\\.(brass-button|cover\\.)", "format": "png" },
      { "match": "^shop\\.symbol\\.", "format": "png", "svgSize": 128, "svgColor": "#ffffff" },
      { "match": "^shop\\.trim\\.", "format": "png" },
      { "match": "^prologue\\.(reaver|rogue|starseer|herald)$", "format": "png", "maxWidth": 700 },
      { "match": "^prologue\\.", "format": "jpg", "quality": 84, "maxWidth": 1600, "maxHeight": 1700 },
      { "match": "^mapdetail\\..*\\.l1024\\.", "format": "jpg", "quality": 84, "flat": true },
      { "match": "^pose\\.", "format": "png" },
      { "match": "^posefx\\.", "format": "png" },
      { "match": "^(alt|sweep|hurt|exp|lite)\\.", "format": "png", "flat": true },
      { "match": "^glow\\.", "format": "png", "flat": true }
    ],
    "derive": [
      { "match": "^(alt|sweep|hurt)\\.(.+)$", "id": "glow.$1.$2", "glow": { "scale": 0.5, "sigma": 1.4, "gain": 2.2 } },
      { "match": "^(exp)\\.(.+)$", "id": "glow.$1.$2", "glow": { "scale": 0.25, "sigma": 0.9, "gain": 2 } }
    ]
  },
  "provenance": {
    "files": ["CREDITS.md"],
    "globs": ["assets/**/provenance.json", "art/**/provenance.json", "art/**/prompts*.json"]
  }
}
