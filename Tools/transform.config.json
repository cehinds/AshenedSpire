{
  "comment": "Maps the exported shipped content (Tools/export/raw) into Unity StreamingAssets/Content (docs/design/08). Data-driven: an output is one row. 'key' = id field(s) for id-keyed catalogs (joined with ':'); 'text' = top-level display fields moved to strings/en.json under '<stringPrefix>.<key>.<name>'. Tables whose key is not unique fail the transform.",
  "contentVersion": "0.7.1",
  "tables": [
    { "out": "catalog/cards.json", "from": "bundle.cards", "key": ["id"], "stringPrefix": "card", "text": { "name": "name", "flavor": "flavor", "textTemplate": "text" } },
    { "out": "catalog/relics.json", "from": "bundle.relics", "key": ["id"], "stringPrefix": "relic", "text": { "name": "name", "flavor": "flavor", "textTemplate": "text" } },
    { "out": "catalog/statuses.json", "from": "bundle.statuses", "key": ["id"], "stringPrefix": "status", "text": { "name": "name", "tooltip": "tooltip" } },
    { "out": "catalog/stances.json", "from": "bundle.stances", "key": ["id"], "stringPrefix": "stance", "text": { "name": "name", "tooltip": "tooltip" } },
    { "out": "catalog/resources.json", "from": "bundle.resources", "key": ["id"], "stringPrefix": "resource", "text": { "name": "name" } },
    { "out": "catalog/keywords.json", "from": "bundle.keywords", "key": ["id"], "stringPrefix": "keyword", "text": { "name": "name", "tooltip": "tooltip" } },
    { "out": "catalog/enemies.json", "from": "bundle.enemies", "key": ["id"], "stringPrefix": "enemy", "text": { "name": "name" } },
    { "out": "catalog/encounters.json", "from": "bundle.encounters", "key": ["id"] },
    { "out": "catalog/seats.json", "from": "bundle.seats", "key": ["id"], "stringPrefix": "seat", "text": { "name": "name" } },
    { "out": "catalog/events.json", "from": "bundle.events", "key": ["id"], "stringPrefix": "event", "text": { "name": "name", "text": "text" } },
    { "out": "catalog/speakers.json", "from": "bundle.speakers", "key": ["id"], "stringPrefix": "speaker", "text": { "name": "name" } },
    { "out": "catalog/atlasQuests.json", "from": "bundle.atlasQuests", "key": ["questId"], "stringPrefix": "quest", "text": { "displayName": "name", "description": "description" } },
    { "out": "catalog/flasks.json", "from": "bundle.flasks", "key": ["id"], "stringPrefix": "flask", "text": { "name": "name", "textTemplate": "text" } },
    { "out": "catalog/classes.json", "from": "bundle.classes", "key": ["id"], "stringPrefix": "class", "text": { "name": "name", "description": "description" } },
    { "out": "catalog/unlocks.json", "from": "bundle.unlocks", "key": ["id"], "stringPrefix": "unlock", "text": { "name": "name", "hint": "hint" } },
    { "out": "catalog/classTree.json", "from": "bundle.classTree", "key": ["classId", "nodeId"] },
    { "out": "catalog/attributes.json", "from": "bundle.attributes", "key": ["id"], "stringPrefix": "attribute", "text": { "label": "label", "shortLabel": "short" } },
    { "out": "catalog/creationModes.json", "from": "bundle.creationModes", "key": ["id"], "stringPrefix": "creationMode", "text": { "label": "label" } },
    { "out": "catalog/armaments.json", "from": "bundle.equipment.armaments", "key": ["id"], "stringPrefix": "armament", "text": { "name": "name" } },
    { "out": "catalog/armour.json", "from": "bundle.equipment.armour", "key": ["classId", "id"], "stringPrefix": "armour", "text": { "name": "name", "blurb": "blurb" } },
    { "out": "catalog/startingKits.json", "from": "bundle.equipment.startingKits", "key": ["id"], "stringPrefix": "kit", "text": { "label": "label" } },
    { "out": "catalog/basicCardProfiles.json", "from": "bundle.equipment.basicCardProfiles", "key": ["id"] },
    { "out": "catalog/weaponCardPackages.json", "from": "extras.weaponCardPackages.weaponCardPackages", "key": ["weaponId"] },
    { "out": "catalog/itemUpgradeChanges.json", "from": "bundle.equipment.itemUpgradeChanges", "list": true },
    { "out": "catalog/cardExposure.json", "from": "bundle.equipment.cardExposure", "list": true },
    { "out": "catalog/cardTagging.json", "from": "bundle.equipment.cardTagging", "list": true },
    { "out": "catalog/equipmentRequirements.json", "from": "bundle.equipment.equipmentRequirements", "list": true },
    { "out": "tags/tagDomains.json", "from": "bundle.tagDomains", "key": ["id"] },
    { "out": "tags/tags.json", "from": "bundle.tags", "key": ["id"] },
    { "out": "tags/tagFamilies.json", "from": "bundle.tagFamilies", "key": ["family"] },
    { "out": "tags/tagFamilyDomains.json", "from": "bundle.tagFamilyDomains", "key": ["family", "domain"] },
    { "out": "tags/tagging.json", "from": "bundle.tagging", "key": ["family", "scope", "objectId", "tagId"] },
    { "out": "tags/propertyRules.json", "from": "bundle.propertyRules", "list": true },
    { "out": "tags/nodes.json", "from": "bundle.nodes", "key": ["id"] },
    { "out": "tags/nodeRelations.json", "from": "bundle.nodeRelations", "list": true },
    { "out": "tags/familyNodes.json", "from": "bundle.familyNodes", "key": ["family", "nodeId"] },
    { "out": "tags/nodeTerms.json", "from": "bundle.nodeTerms", "list": true },
    { "out": "tags/nodeVariables.json", "from": "bundle.nodeVariables", "list": true },
    { "out": "tags/variableBindings.json", "from": "bundle.variableBindings", "list": true }
  ],
  "objects": [
    { "out": "balance/balance.json", "from": "bundle.balance" },
    { "out": "balance/mapConfigs.json", "from": "bundle.mapConfigs" },
    { "out": "balance/mapShape.json", "from": "extras.mapconfig" },
    { "out": "balance/customRun.json", "from": "extras.customMods" },
    { "out": "rules/attributeRules.json", "from": "bundle.attributeRules" },
    { "out": "rules/derivedStatRules.json", "from": "bundle.derivedStatRules" },
    { "out": "rules/handRules.json", "from": "extras.handRules.handRulesDefaults" },
    { "out": "rules/combatRules.json", "from": "extras.combatRules.combatRules" },
    { "out": "rules/mechanics.json", "from": "extras.framework.mechanics" },
    { "out": "rules/propertyRuleEffects.json", "from": "extras.propertyRuleEffects.propertyRuleEffects" },
    { "out": "rules/nodeEffects.json", "from": "bundle.nodeEffects" },
    { "out": "catalog/equipmentSlots.json", "from": "bundle.equipment.slots" },
    { "out": "catalog/equipmentMeta.json", "from": "bundle.equipment", "omit": ["armaments", "armour", "startingKits", "basicCardProfiles", "itemUpgradeChanges", "cardExposure", "cardTagging", "equipmentRequirements", "slots"] },
    { "out": "catalog/bossDestinations.json", "from": "extras.bossDestinations.BOSS_LOCATIONS" },
    { "out": "catalog/legacyDungeons.json", "from": "extras.legacyDungeons.legacyDungeons" },
    { "out": "catalog/worldAtlas.json", "from": "extras.worldAtlas.worldAtlas" },
    { "out": "catalog/characterCreation.json", "from": "bundle.characterCreation" },
    { "out": "catalog/eventMeta.json", "from": "bundle", "pick": ["eventHistoryRequirements", "eventChoiceIds", "questChains", "eventSpeakers"] },
    { "out": "catalog/eventChoiceRequirements.json", "from": "extras.events.eventChoiceHistoryRequirements" },
    { "out": "ui/locationPresentation.json", "from": "extras.locationPresentation.locationPresentation" },
    { "out": "ui/theme.json", "from": "extras.framework.theme" },
    { "out": "ui/terms.json", "from": "extras.framework.terms" },
    { "out": "ui/confirmationPolicies.json", "from": "extras.framework.confirmationPolicies" },
    { "out": "audio/sfx.json", "from": "extras.sfx", "pick": ["SFX_RECIPES", "SFX_FAMILY_IDS"] },
    { "out": "audio/music.json", "from": "extras.music", "pick": ["BEDS", "SCALES"] }
  ],
  "uiStrings": { "from": "extras.uiStrings.uiStrings", "prefix": "ui", "fields": ["short", "full", "tip"] },
  "expectedCounts": {
    "catalog/cards.json": 195, "catalog/relics.json": 63, "catalog/statuses.json": 50, "catalog/stances.json": 3,
    "catalog/enemies.json": 33, "catalog/encounters.json": 35, "catalog/events.json": 25, "catalog/flasks.json": 7,
    "catalog/classes.json": 4, "catalog/unlocks.json": 18, "catalog/classTree.json": 24, "catalog/armaments.json": 28,
    "catalog/armour.json": 35, "catalog/startingKits.json": 8, "catalog/weaponCardPackages.json": 28, "catalog/seats.json": 3
  }
}
