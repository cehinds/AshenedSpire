    { "out": "catalog/seats.json", "from": "bundle.seats", "key": ["id"], "stringPrefix": "seat", "text": { "name": "name" } },
    { "out": "catalog/events.json", "from": "bundle.events", "key": ["id"], "stringPrefix": "event", "text": { "name": "name", "text": "text" } },
    { "out": "catalog/speakers.json", "from": "bundle.speakers", "key": ["id"], "stringPrefix": "speaker", "text": { "name": "name" } },
    { "out": "catalog/atlasQuests.json", "from": "bundle.atlasQuests", "key": ["questId"], "stringPrefix": "quest", "text": { "displayName": "name", "description": "description" } },
    { "out": "catalog/flasks.json", "from": "bundle.flasks", "key": ["id"], "stringPrefix": "flask", "text": { "name": "name", "textTemplate": "text" } },
    { "out": "catalog/classes.json", "from": "bundle.classes", "key": ["id"], "stringPrefix": "class", "text": { "name": "name", "description": "description" } },
    { "out": "catalog/unlocks.json", "from": "bundle.unlocks", "key": ["id"], "stringPrefix": "unlock", "text": { "name": "name", "hint": "hint" } },
