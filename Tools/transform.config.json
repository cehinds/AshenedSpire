    { "out": "tags/nodeTerms.json", "from": "bundle.nodeTerms", "list": true },
    { "out": "tags/nodeVariables.json", "from": "bundle.nodeVariables", "list": true },
    { "out": "tags/variableBindings.json", "from": "bundle.variableBindings", "list": true }
