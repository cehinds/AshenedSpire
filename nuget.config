<?xml version="1.0" encoding="utf-8"?>
<!-- Repo-local NuGet config (D-031): ignore machine-level sources so restores are reproducible on any machine and in CI,
     and keep the package cache inside the repo's gitignored .cache/ (the system drive on the dev machine is full). -->
<configuration>
  <config>
    <add key="globalPackagesFolder" value=".cache/nuget" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
